# 复制为 .env 后可按本地环境修改。生产环境请设置随机 JWT_SECRET 和强密码。
POSTGRES_DB=ontology
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology-local-password
DATABASE_URL=postgresql+psycopg://ontology:ontology-local-password@postgres:5432/ontology
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-this-local-secret-before-sharing-000000000000
JWT_ACCESS_TOKEN_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-local-password
WEB_PORT=5173
ONTOLOGY_API_PORT=8000
AGENT_SERVICE_PORT=8001
# 可选：OpenAI Chat Completions 兼容运行时；留空时仅提供明确标注的本地 dry-run。
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_DEFAULT_NAME=
AGENT_MODEL_TIMEOUT_SECONDS=60
